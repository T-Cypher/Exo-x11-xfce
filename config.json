{
    "barAutoHideFullscreen": true,
    "barCentered": false,
    "barDensity": 2,
    "barFloating": true,
    "barMargin": 4,
    "barModulesCenter": [
        "windowInfo"
    ],
    "barModulesLeft": [
        "launcher",
        "workspaces",
        "quickSettings",
        "clock"
    ],
    "barModulesRight": [
        "media",
        "statusIcons",
        "tray",
        "battery"
    ],
    "barPosition": "top",
    "barRound": false,
    "barSeparated": true,
    "barVertical": false,
    "batteryDevice": "",
    "brightnessDevice": "",
    "clockDayMonthSwapped": false,
    "clockMilitary": false,
    "clockSwapVertical": true,
    "launcherColumns": 5,
